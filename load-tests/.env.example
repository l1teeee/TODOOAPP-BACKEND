# API base URL; never use production.
BASE_URL=http://localhost:4000
# Set to the exact BASE_URL to allow a non-local test target.
LOADTEST_ALLOWED_BASE_URL=
# First DNS label of the dedicated Supabase test project host.
LOADTEST_SUPABASE_PROJECT_REF=
# Supabase publishable key.
SUPABASE_PUBLISHABLE_KEY=
# Number of test users to prepare.
LOADTEST_USER_COUNT=20
# Delay between Supabase sign-ins in milliseconds.
LOADTEST_SIGNIN_DELAY_MS=2100
# Password for test users, at least 12 characters.
LOADTEST_USER_PASSWORD=
# Domain used for test user email addresses.
LOADTEST_EMAIL_DOMAIN=example.com
# Constant arrival rate in iterations per second.
RATE=50
# Duration of the constant load test.
DURATION=10m
# Baseline spike test rate.
BASE_RATE=10
# Peak spike test rate.
SPIKE_RATE=500
# Breakpoint step rates in iterations per second.
BREAKPOINT_RATES=10,20,40,80,160,320,640,1280
# Warm-up duration in seconds; 0 disables it.
WARMUP_SECONDS=60
# Duration of each steady breakpoint step.
STEP_SECONDS=60
# Grafana Cloud k6 free tier allows 100 VUs per test.
MAX_VUS=100
