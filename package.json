{
  "name": "todo-app-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch --import tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:agent": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --runInBand",
    "start": "node --import ./dist/platform/observability/instrument-api.js dist/main.js",
    "start:local": "node --env-file-if-exists=.env --import ./dist/platform/observability/instrument-api.js dist/main.js",
    "start:worker": "node --import ./dist/platform/observability/instrument-worker.js dist/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/platform/db/migrate.js",
    "db:migrate:dev": "node --env-file-if-exists=.env --import tsx src/platform/db/migrate.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run build",
    "openapi:export": "node --env-file-if-exists=.env --import tsx src/scripts/export-openapi.ts",
    "prepare": "node scripts/install-git-hooks.mjs",
    "load:users": "node --env-file-if-exists=.env --env-file-if-exists=load-tests/.env --import tsx src/scripts/load-test-users.ts",
    "load": "node --env-file-if-exists=load-tests/.env --import tsx src/scripts/run-load-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
    "@opentelemetry/instrumentation-http": "0.301.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/instrumentation-runtime-node": "0.38.0",
    "@opentelemetry/instrumentation-undici": "0.35.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-logs": "3.1.0",
    "@opentelemetry/sdk-metrics": "3.1.0",
    "@opentelemetry/sdk-node": "0.301.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@sentry/node": "11.11.0",
    "@supabase/supabase-js": "2.119.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "import-in-the-middle": "3.5.3",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.5.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
