# Runtime environment.
NODE_ENV=development
# Address to listen on.
HOST=0.0.0.0
# Port to listen on.
PORT=4000
# Minimum log level.
LOG_LEVEL=info
# Sentry project todo-app-backend; empty disables Sentry.
SENTRY_DSN=
# Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Defaults to RAILWAY_GIT_COMMIT_SHA, then the package version.
SENTRY_RELEASE=
# Grafana Cloud OTLP gateway base URL ending in /otlp; empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Copy from the Grafana Cloud OpenTelemetry tile: Authorization=Basic%20<base64 of instanceId:token>.
OTEL_EXPORTER_OTLP_HEADERS=
# Use OTLP over HTTP protobuf.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Use parent-based ratio sampling.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
# Fraction of new traces kept; use 0.1 for load tests.
OTEL_TRACES_SAMPLER_ARG=1
# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Trusted proxy hops: 1 on Railway.
TRUST_PROXY_HOPS=0
# Maximum requests per rate limit window.
RATE_LIMIT_MAX=300
# Rate limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_app
# Maximum number of Postgres connections per process (1-50).
DATABASE_POOL_MAX=10
# Enable TLS for the Postgres connection.
DATABASE_SSL=false
# Supabase project HTTPS origin without a trailing slash.
SUPABASE_URL=https://your-project.supabase.co
# Supabase secret or service_role key; server only, never in the frontend.
SUPABASE_SECRET_KEY=
# Cloudflare test secret that always passes; rejected in production. Set the real secret on Railway.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Email provider: brevo, resend or log (log is unavailable in production).
EMAIL_PROVIDER=log
# Sender email address.
EMAIL_FROM=no-reply@example.com
# Sender display name.
EMAIL_FROM_NAME=TODO App
# Brevo API key, required only when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
# Resend API key, required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Frontend public origin for notification email links (no trailing slash).
APP_URL=http://localhost:3000
# Minutes before a reminder to enqueue its alert (0-1440).
REMINDER_LEAD_MINUTES=15
# Maximum emails claimed per worker drain run (1-100).
OUTBOX_BATCH_SIZE=20
# The AI assistant module turns on when the DeepInfra API key is set.
# DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
# AI request timeout in milliseconds (1000-60000; default 20000).
# AI_TIMEOUT_MS=20000
