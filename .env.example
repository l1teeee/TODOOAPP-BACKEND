# Runtime environment.
NODE_ENV=development
# Address to listen on.
HOST=0.0.0.0
# Port to listen on.
PORT=4000
# Minimum log level.
LOG_LEVEL=info
# Comma-separated allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Trusted proxy hops: 1 on Railway.
TRUST_PROXY_HOPS=0
# Maximum requests per rate limit window.
RATE_LIMIT_MAX=300
# Rate limit window in milliseconds.
RATE_LIMIT_WINDOW_MS=60000
# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_app
# Maximum number of Postgres connections per process (1-50).
DATABASE_POOL_MAX=10
# Enable TLS for the Postgres connection.
DATABASE_SSL=false
# Supabase project HTTPS origin without a trailing slash.
SUPABASE_URL=https://your-project.supabase.co
# Email provider: brevo, resend or log (log is unavailable in production).
EMAIL_PROVIDER=log
# Sender email address.
EMAIL_FROM=no-reply@example.com
# Sender display name.
EMAIL_FROM_NAME=TODO App
# Brevo API key, required only when EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
# Resend API key, required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# The AI assistant module turns on when the DeepInfra API key is set.
# DEEPINFRA_API_KEY=
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
